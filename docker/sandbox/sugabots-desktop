#!/bin/bash
# Desktops in this sandbox, each on its own display, so agents working at the
# same time never click on each other's windows.
#
#   sugabots-desktop start [display]               start a bare desktop, print its DISPLAY
#   sugabots-desktop stop display                  stop it, and its browser
#   sugabots-desktop session name profile output   a desktop with a browser for `name`
#   sugabots-desktop viewer name                   the viewer port of `name`'s desktop, if running
#
# `session` is what Sugabots runs for an agent in a thread. It starts the
# named desktop, or finds it already running, and prints
# `display=N viewer=PORT browser=PORT started=yes|no`. The browser is
# Chromium driven by Playwright MCP, shown on the desktop so people watching
# see what the agent does, with its profile in `profile` and its downloads and
# screenshots in `output`. A session whose programs stopped, as they do when a
# paused sandbox comes back, starts again on the same display.
#
# Display N is served to a VNC viewer on port 5900+N, to a browser through
# noVNC on port 6080+N, and its browser's MCP server is on port 8930+N.
set -euo pipefail

# Set here rather than relied on from the image: E2B runs commands without
# the image's ENV.
export LANG="${LANG:-C.UTF-8}" PYTHONPATH=/opt/websockify

state="${TMPDIR:-/tmp}/sugabots-desktop"
mkdir -p "$state/sessions"

free_display() {
	local n=1
	while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ] || [ -n "$(grep -lx "$n" "$state"/sessions/* 2>/dev/null)" ]; do
		n=$((n + 1))
	done
	echo "$n"
}

# Whether every program started for display N is still running.
running() {
	local pids="$state/$1.pids"
	[ -f "$pids" ] || return 1
	while read -r pid; do kill -0 "$pid" 2>/dev/null || return 1; done <"$pids"
}

desktop() {
	local n="$1" log="$state/$1.log"
	export DISPLAY=":$n"
	rm -f "/tmp/.X$n-lock" "/tmp/.X11-unix/X$n"
	# -ac: any program in this sandbox may draw on it. -s 0: no screensaver,
	# which would blank the screen after ten minutes without keyboard or mouse
	# input, and agents drive the browser through Playwright, not the X server.
	Xvfb "$DISPLAY" -screen 0 1280x800x24 -ac -s 0 -nolisten tcp >>"$log" 2>&1 &
	echo $! >"$state/$n.pids"
	for _ in $(seq 50); do [ -e "/tmp/.X11-unix/X$n" ] && break; sleep 0.1; done
	hsetroot -fill /usr/share/sugabots-desktop/wallpaper.png >>"$log" 2>&1
	openbox >>"$log" 2>&1 &
	echo $! >>"$state/$n.pids"
	# No password: the ports are reached only through Sugabots.
	x11vnc -display "$DISPLAY" -nopw -forever -shared -quiet -rfbport $((5900 + n)) >>"$log" 2>&1 &
	echo $! >>"$state/$n.pids"
	python3 -m websockify --web /opt/novnc $((6080 + n)) localhost:$((5900 + n)) >>"$log" 2>&1 &
	echo $! >>"$state/$n.pids"
}

browser() {
	local n="$1" profile="$2" output="$3" log="$state/$1.log"
	mkdir -p "$profile" "$output"
	DISPLAY=":$n" playwright-mcp --host 0.0.0.0 --port $((8930 + n)) --allowed-hosts '*' \
		--executable-path /usr/bin/chromium --no-sandbox --viewport-size 1280x720 \
		--user-data-dir "$profile" --output-dir "$output" --file-paths absolute >>"$log" 2>&1 &
	echo $! >>"$state/$n.pids"
	for _ in $(seq 100); do
		curl -s -o /dev/null "http://localhost:$((8930 + n))/mcp" && break
		sleep 0.1
	done
}

stop() {
	local n="${1:?which display}"
	[ -f "$state/$n.pids" ] || return 0
	xargs -r kill <"$state/$n.pids" 2>/dev/null || true
	rm -f "$state/$n.pids"
}

session() {
	local name="${1:?name}" profile="${2:?profile directory}" output="${3:?output directory}"
	local file="$state/sessions/$name" n started=no
	if [ -f "$file" ]; then n="$(cat "$file")"; else n="$(free_display)"; echo "$n" >"$file"; fi
	if ! running "$n"; then
		stop "$n"
		desktop "$n"
		browser "$n" "$profile" "$output"
		started=yes
	fi
	echo "display=$n viewer=$((6080 + n)) browser=$((8930 + n)) started=$started"
}

viewer() {
	local file="$state/sessions/${1:?name}"
	[ -f "$file" ] || exit 3
	local n
	n="$(cat "$file")"
	running "$n" || exit 3
	echo $((6080 + n))
}

case "${1:-}" in
start)
	n="${2:-$(free_display)}"
	desktop "$n"
	echo "DISPLAY=:$n"
	;;
stop) stop "${2:-}" ;;
session) session "${2:-}" "${3:-}" "${4:-}" ;;
viewer) viewer "${2:-}" ;;
*)
	echo "usage: sugabots-desktop start [display] | stop display | session name profile output | viewer name" >&2
	exit 2
	;;
esac
